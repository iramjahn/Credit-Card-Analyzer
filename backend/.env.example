# Copy to backend/.env and fill in real values. Never commit the real .env.

# --- Auth ---
# Secret used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-in-production

# --- Plaid (optional; integration is currently mocked) ---
# Get these from the Plaid dashboard: https://dashboard.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
